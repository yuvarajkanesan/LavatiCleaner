{
 "rules": [
  {
   "id": "chrome_cache",
   "category": "Chrome Browser",
   "label": "Page & asset cache",
   "tab": "apps",
   "risk": "safe",
   "paths": [
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache",
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache",
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache",
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Service Worker\\CacheStorage"
   ],
   "requires_closed": [
    "chrome.exe"
   ],
   "note": "Temporary web files the browser rebuilds as you browse. Pages may load a little slower the first time afterwards.",
   "quarantine": false
  },
  {
   "id": "chrome_cookies",
   "category": "Chrome Browser",
   "label": "Cookies & site data",
   "tab": "apps",
   "risk": "review",
   "paths": [
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*",
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Network"
   ],
   "include": [
    "Cookies",
    "Cookies-journal"
   ],
   "recursive": false,
   "requires_closed": [
    "chrome.exe"
   ],
   "note": "Signs you out of websites and resets site preferences. Removed files go to quarantine, so you can restore them."
  },
  {
   "id": "chrome_history",
   "category": "Chrome Browser",
   "label": "Browsing trail",
   "tab": "apps",
   "risk": "review",
   "paths": [
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*"
   ],
   "include": [
    "History",
    "History-journal",
    "Visited Links",
    "Top Sites",
    "Top Sites-journal",
    "Favicons",
    "Favicons-journal"
   ],
   "recursive": false,
   "requires_closed": [
    "chrome.exe"
   ],
   "note": "Clears the visited-pages list and top-site thumbnails. Bookmarks are not touched. Restorable from quarantine."
  },
  {
   "id": "chrome_session",
   "category": "Chrome Browser",
   "label": "Last-session tabs",
   "tab": "apps",
   "risk": "review",
   "paths": [
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*",
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Sessions"
   ],
   "include": [
    "Current Session",
    "Current Tabs",
    "Last Session",
    "Last Tabs",
    "Session_*",
    "Tabs_*"
   ],
   "recursive": false,
   "requires_closed": [
    "chrome.exe"
   ],
   "note": "Forgets the tabs from your last session, so 'restore previous tabs' will have nothing to bring back."
  },
  {
   "id": "chrome_forms",
   "category": "Chrome Browser",
   "label": "Autofill profiles",
   "tab": "apps",
   "risk": "advanced",
   "paths": [
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*"
   ],
   "include": [
    "Web Data",
    "Web Data-journal"
   ],
   "recursive": false,
   "requires_closed": [
    "chrome.exe"
   ],
   "note": "Removes saved autofill entries (names, addresses, cards saved in the browser). Restorable from quarantine."
  },
  {
   "id": "chrome_logins",
   "category": "Chrome Browser",
   "label": "Stored sign-ins",
   "tab": "apps",
   "risk": "advanced",
   "paths": [
    "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*"
   ],
   "include": [
    "Login Data",
    "Login Data-journal",
    "Login Data For Account",
    "Login Data For Account-journal"
   ],
   "recursive": false,
   "requires_closed": [
    "chrome.exe"
   ],
   "note": "Removes passwords saved in this browser, so you must sign in again. Restorable from quarantine. Passwords synced to an account can return on the next sync."
  },
